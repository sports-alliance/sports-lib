{
  "name": "@sports-alliance/sports-lib",
  "version": "23.9.1",
  "description": "TypeScript library for importing, exporting, and analyzing sports activities and routes from FIT, GPX, TCX, and JSON, with standardized activity, health, and sleep metrics.",
  "keywords": [
    "typescript",
    "javascript",
    "fitness",
    "sports-analytics",
    "activity-tracking",
    "quantified-self",
    "gpx",
    "tcx",
    "fit",
    "suunto",
    "garmin",
    "polar",
    "routes",
    "health-data",
    "sleep-data",
    "export",
    "import",
    "parser"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./metrics": {
      "types": "./lib/esm/metrics.d.ts",
      "import": "./lib/esm/metrics.js",
      "require": "./lib/cjs/metrics.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:metadata",
    "build:esm": "tsc --project tsconfig.types.json && tsc --project tsconfig.esm.json && node scripts/rewrite-esm-specifiers.mjs out-tsc/esm .js && rollup --silent --config rollup.config.mjs && node scripts/rewrite-esm-specifiers.mjs lib/esm .d.ts && rimraf ./out-tsc/esm/",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:metadata": "node scripts/write-build-package-metadata.mjs",
    "watch": "npm run build -- --watch",
    "clean": "rimraf ./lib/ ./out-tsc/esm/",
    "docs:build": "typedoc --options typedoc.json && node scripts/verify-docs.mjs",
    "generate:docs": "npm run docs:build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:package": "eslint rollup.config.mjs scripts/fixtures/metrics-worker.mjs scripts/fixtures/representative-startup.mjs scripts/fixtures/sportslib-facade-startup.mjs scripts/rewrite-esm-specifiers.mjs scripts/verify-package.mjs scripts/write-build-package-metadata.mjs",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "test:package": "node scripts/verify-package.mjs",
    "bench:json": "node --expose-gc scripts/benchmark-json-hydration.mjs",
    "test-coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "prepack": "npm run build",
    "report:tss": "npx --yes tsx scripts/generate-tss-validation-report.ts",
    "prettier:fix": "prettier --write .",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sports-alliance/sports-lib.git"
  },
  "bugs": {
    "url": "https://github.com/sports-alliance/sports-lib/issues"
  },
  "homepage": "https://sports-alliance.github.io/sports-lib/",
  "author": "Sports-Alliance",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@googlemaps/polyline-codec": "^1.0.28",
    "fast-xml-parser": "^5.11.2",
    "fit-file-parser": "^6.2.7",
    "geolib": "^4.0.0",
    "gpx-builder": "3.8.0",
    "kalmanjs": "^1.1.0",
    "lowpassf": "^0.5.0",
    "moving-median": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@xmldom/xmldom": "^0.8.15",
    "babel-jest": "^30.5.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "ts-jest": "^29.4.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "typesVersions": {
    "*": {
      "metrics": [
        "lib/esm/metrics.d.ts"
      ]
    }
  }
}
